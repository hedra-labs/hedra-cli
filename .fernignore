# Files owned by the user — fern generate will not overwrite these.
cli/hedra/custom.rs
README.md

# Hand-fixed runtime file: serializes the PAGER env-var tests (flaky in CI).
# The fern-cli-generator runtime doesn't carry this fix yet; regeneration
# must not revert it. Drop this entry once the fix lands upstream.
src/pager.rs

# Workspace metadata (crate name/authors/version) + lockfile are hand-owned;
# the generator would reset them to fern-cli-sdk defaults. Drop these two
# entries when upstream adds crate-metadata config (also restores generator
# dependency updates): https://github.com/fern-api/fern/issues/16976
Cargo.toml
Cargo.lock

# Release pipeline (cargo-dist) + CI + Dependabot are hand-maintained.
dist-workspace.toml
.github/
