# Files owned by the user — fern generate will not overwrite these.
cli/hedra/custom.rs
README.md

# Hand-fixed runtime file: serializes the PAGER env-var tests (flaky in CI).
# The fern-cli-generator runtime doesn't carry this fix yet; regeneration
# must not revert it. Drop this entry once the fix lands upstream.
src/pager.rs

# Cargo.toml is generator-owned: fern-config sets `packageIdentity` for
# fern-cli-generator, so regeneration writes hedra-cli's crate identity rather
# than the fern-cli-sdk defaults. The lockfile is still hand-owned — the
# generator does not emit one (ENG-10048).
Cargo.lock

# Release pipeline (cargo-dist) + CI + Dependabot are hand-maintained.
dist-workspace.toml
.github/
.fern/replay.lock
.fern/replay.yml
.gitattributes
